# Anthropic (idea + storyboard generation)
ANTHROPIC_API_KEY=
# Optional: override the model. Defaults to claude-opus-5.
ANTHROPIC_MODEL=

# Nano Banana Pro / Gemini image generation
GEMINI_API_KEY=

# Hailuo / MiniMax video generation
MINIMAX_API_KEY=

# Telegram approval bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# YouTube Data API (OAuth refresh token flow)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional tuning
# Seconds to wait for the Telegram approval tap before giving up (default 3600).
# On GitHub Actions this wait is billed as job minutes — keep it short.
APPROVAL_TIMEOUT_SEC=
# Abort before spending if a storyboard would cost more than this (default 5.0).
MAX_COST_USD=
# Absolute path to a .ttf used for burned-in captions (auto-detected if unset).
CAPTION_FONT=
# Validation-phase spend guard: cumulative cost_log spend that blocks the run
# (default 125.0). Checked before that day's spend, so the real ceiling is
# roughly this plus one video's cost.
VALIDATION_BUDGET_USD=
# Videos generated since the last human checkpoint review before the run
# blocks (default 10). Do NOT set to 0 to disable — that blocks every run;
# use a very large number instead.
VALIDATION_CHECKPOINT_EVERY=
# Number of videos reviewed as of the last checkpoint ack (default 0). Raise
# this by hand after checking YouTube Studio to unblock the next checkpoint.
VALIDATION_ACK_COUNT=

# Anthropic (idea + storyboard generation)
ANTHROPIC_API_KEY=
# Optional: override the model. Defaults to claude-opus-5.
ANTHROPIC_MODEL=

# Nano Banana Pro / Gemini image generation
GEMINI_API_KEY=

# Hailuo / MiniMax video generation
MINIMAX_API_KEY=

# Telegram approval bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# YouTube Data API (OAuth refresh token flow)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional tuning
# Seconds to wait for the Telegram approval tap before giving up (default 3600).
# On GitHub Actions this wait is billed as job minutes — keep it short.
APPROVAL_TIMEOUT_SEC=
# Abort before spending if a storyboard would cost more than this (default 5.0).
MAX_COST_USD=
# Absolute path to a .ttf used for burned-in captions (auto-detected if unset).
CAPTION_FONT=
